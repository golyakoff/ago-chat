<?xml version="1.0" encoding="utf-8"?>
<!--
  CI-only source list (adr/0015). `nuget.config` at the repo root points at the developer's local
  file feed (C:\git\ago\.nuget-feed), which does not exist on a CI runner - this file replaces it
  with the throwaway feed the workflow packs ago-platform's current main into, in the same job.
  Never used for local development; the workflow selects it explicitly via the configfile flag.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="ago-platform-ci" value="nuget-feed-ci" />
  </packageSources>
</configuration>

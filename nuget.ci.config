<?xml version="1.0" encoding="utf-8"?>
<!--
  CI-only source list (adr/0018). `nuget.config` at the repo root points at the developer's local
  file feed (C:\git\ago\.nuget-feed), which does not exist on a CI runner - this file replaces it
  with ago-platform's real GitHub Packages feed. Never used for local development; the workflow
  selects it explicitly via the configfile flag. No secret value lives here - AGO_PLATFORM_PACKAGES_TOKEN
  is a placeholder the workflow's env supplies at restore time (adr/0018; repositories.md - no
  secrets, ever, in a repository).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="ago-platform-github" value="https://nuget.pkg.github.com/golyakoff/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <ago-platform-github>
      <add key="Username" value="golyakoff" />
      <add key="ClearTextPassword" value="%AGO_PLATFORM_PACKAGES_TOKEN%" />
    </ago-platform-github>
  </packageSourceCredentials>
  <!-- Required with central package management once 2+ sources are configured (NU1507) - without
       it, NuGet cannot tell which source should serve a given package, and Directory.Build.props'
       TreatWarningsAsErrors turns that ambiguity into a hard restore failure. -->
  <packageSourceMapping>
    <packageSource key="ago-platform-github">
      <package pattern="Ago.Platform.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

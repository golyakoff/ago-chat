<?xml version="1.0" encoding="utf-8"?>
<!--
  Used only inside the Docker build (Dockerfile) - the repo's own nuget.config points at the local
  feed by its Windows host path, which does not exist inside the Linux build container. This one
  clears every inherited source and fallback folder explicitly, so the build never depends on
  whatever NuGet.Config the base SDK image happens to ship with.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-feed" value="/nuget-feed" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>

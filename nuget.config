<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="ago-local" value="C:\git\ago\.nuget-feed" />
  </packageSources>
  <!-- Required with central package management once 2+ sources are configured (NU1507) - without
       it, NuGet cannot tell which source should serve a given package. Not observed failing
       locally (found only on the CI runner's SDK patch, adr/0018), but the ambiguity is real
       either way, so mapped explicitly here too rather than relying on that difference. -->
  <packageSourceMapping>
    <packageSource key="ago-local">
      <package pattern="Ago.Platform.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

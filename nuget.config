<?xml version="1.0" encoding="utf-8"?>
<!--
  17-11 (golyakoff/ago-root#396): this file used to name the local file feed by its Windows host
  path (C:\git\ago\.nuget-feed), after a <clear/>. That path does not exist on Dependabot's Linux
  runner, and a *configured* local source that does not exist is a hard restore error (NU1301) -
  different from a source that is simply not configured, which NuGet treats as "no source for this
  pattern" (NU1100) and, critically, does not stop another mapped source from serving the package.
  Dependabot's own update-job log confirmed the former: "The local source
  '/home/dependabot/dependabot-updater/repo/C:\git\ago\.nuget-feed' doesn't exist." - Dependabot had
  rewritten the Windows path as relative and appended it to the clone root. That NU1301 aborted
  dependency discovery for every project touching Ago.Platform.*, which is why Dependabot has never
  opened a NuGet PR here.

  The fix has two halves:
  - <packageSources> declares nuget.org only, with no <clear/>, so this file can inherit sources
    merged in from outside it rather than only from itself.
  - <packageSourceMapping> names two sources for "Ago.Platform.*" - "ago-local" and
    "ago-platform-github" - neither declared *in this file*. Each environment supplies at most one
    of them from outside: local development merges in "ago-local" from a workspace-level
    NuGet.Config one directory above every sibling checkout (C:\git\ago\NuGet.Config,
    ago-root/docs/runbooks/workspace.md); Dependabot injects "ago-platform-github" via this
    repository's own dependabot.yml `registries:` block, pointing at the same GitHub Packages feed
    nuget.ci.config already proves works for CI (adr/0018). A source that is merely referenced in
    packageSourceMapping but never actually configured in the resolved config is not an error - it
    is simply not tried, confirmed empirically before this change shipped (dotnet restore with
    "ago-platform-github" mapped but never declared anywhere still restores cleanly through
    "ago-local"). CI and the Docker image build are unaffected: both pass their own configfile
    flag (nuget.ci.config / nuget.docker.config), which replaces discovery from this file entirely
    rather than merging with it.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Required with central package management once 2+ sources are configured (NU1507) - without
       it, NuGet cannot tell which source should serve a given package. -->
  <packageSourceMapping>
    <packageSource key="ago-local">
      <package pattern="Ago.Platform.*" />
    </packageSource>
    <packageSource key="ago-platform-github">
      <package pattern="Ago.Platform.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

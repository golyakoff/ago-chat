<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>dotnet-Ago.Chat.Worker-9c664a27-772e-421d-b7d6-e083b912978b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ago.Chat.Module\Ago.Chat.Module.csproj" />
    <!-- `8-07`: this host mints (Api) or expires (Worker) demo tenants, so it talks to Keycloak.
         Ago.Chat.Webhooks deliberately does not reference this and is never handed the credential. -->
    <ProjectReference Include="..\Ago.Chat.Infrastructure.Keycloak\Ago.Chat.Infrastructure.Keycloak.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- `5-04`: MIT-licensed, free for commercial use unconditionally - unlike
         SixLabors.ImageSharp's revenue-gated split license, the author's own choice for
         AttachmentThumbnailGenerator. Native binding (Skia), so both a managed and a native-assets
         package are needed; Linux for the container image, Win32 for local `dotnet run`/tests on
         this dev machine. -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
  </ItemGroup>


  <!-- `7-09`: telemetry moved out of Ago.Platform.Hosting into its own package, so the hosts that
       actually wire it declare it themselves. Ago.Chat.Module deliberately does not - it is
       host-agnostic, and a package that needs an IEndpointRouteBuilder does not belong there. -->
  <ItemGroup Condition="'$(AgoPlatformDevOverride)' != 'true'">
    <PackageReference Include="Ago.Platform.Observability" />
  </ItemGroup>

  <ItemGroup Condition="'$(AgoPlatformDevOverride)' == 'true'">
    <ProjectReference Include="..\..\..\ago-platform\src\Ago.Platform.Observability\Ago.Platform.Observability.csproj" />
  </ItemGroup>

</Project>

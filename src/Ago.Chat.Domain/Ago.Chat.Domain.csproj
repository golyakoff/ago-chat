<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ago.Platform.Kernel only - the dependency rule allows nothing else in from outside this project
    (clean-architecture.md). Same PackageReference/ProjectReference dev-override switch as every
    other project that touches the platform (repositories.md).
  -->
  <ItemGroup Condition="'$(AgoPlatformDevOverride)' != 'true'">
    <PackageReference Include="Ago.Platform.Kernel" />
  </ItemGroup>

  <ItemGroup Condition="'$(AgoPlatformDevOverride)' == 'true'">
    <ProjectReference Include="..\..\..\ago-platform\src\Ago.Platform.Kernel\Ago.Platform.Kernel.csproj" />
  </ItemGroup>

</Project>

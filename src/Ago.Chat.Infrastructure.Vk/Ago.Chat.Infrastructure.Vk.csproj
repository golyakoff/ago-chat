<Project Sdk="Microsoft.NET.Sdk">

  <!-- `14-08`: a project of its own because VK is a distinct external technology -
       `naming-and-structure.md`'s "one project per external technology" rule, the same reason
       Ago.Chat.Infrastructure.MaxBot/.Telegram each exist. Everything that knows VK's own HTTP shape
       (its DTOs, its base URL, its Callback API confirmation/message envelope) lives here and nowhere
       above it - ChannelPortTests.NoProviderVocabulary_AppearsAboveInfrastructure is what makes that a
       checked rule rather than a convention, and it already lists "Vk" among the forbidden name
       fragments above this boundary. -->
  <ItemGroup>
    <ProjectReference Include="..\Ago.Chat.Application\Ago.Chat.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>

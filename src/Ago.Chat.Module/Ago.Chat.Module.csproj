    <PackageReference Include="Ago.Platform.Messaging.RabbitMq" />
    <PackageReference Include="Ago.Platform.Realtime" />
    <PackageReference Include="Ago.Platform.Caching.Redis" />
    <!-- `5-03`: AddS3FileStorage is registered here, alongside AddRedisCaching/AddRabbitMqMessaging -
         ChatModule.ConfigureServices is where every host-agnostic port gets wired up. -->
    <PackageReference Include="Ago.Platform.Storage.S3" />
    <!-- `14-01`: unlike `6-05`'s webhook dispatcher, whose pipelines are private to Ago.Chat.Webhooks
         because only that host dispatches, a channel adapter's outbound call can be made from whichever
         host runs that adapter (a webhook receiver, a long-polling worker - `14-02`/`14-03` decide).
         ChannelResiliencePipelines/ResilientInboundChannelAdapter therefore live here, host-agnostic,
         the same place ChannelMessagePipeline sits for the same reason. -->
    <PackageReference Include="Ago.Platform.Resilience" />
  </ItemGroup>

  <ItemGroup Condition="'$(AgoPlatformDevOverride)' == 'true'">
    <ProjectReference Include="..\..\..\ago-platform\src\Ago.Platform.Hosting\Ago.Platform.Hosting.csproj" />

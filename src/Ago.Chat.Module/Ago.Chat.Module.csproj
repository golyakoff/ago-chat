<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup Condition="'$(AgoPlatformDevOverride)' != 'true'">
    <PackageReference Include="Ago.Platform.Hosting" />
    <PackageReference Include="Ago.Platform.Messaging.RabbitMq" />
    <PackageReference Include="Ago.Platform.Realtime" />
    <PackageReference Include="Ago.Platform.Caching.Redis" />
    <!-- `5-03`: AddS3FileStorage is registered here, alongside AddRedisCaching/AddRabbitMqMessaging -
         ChatModule.ConfigureServices is where every host-agnostic port gets wired up. -->
    <PackageReference Include="Ago.Platform.Storage.S3" />
    <!-- `14-01`: unlike `6-05`'s webhook dispatcher, whose pipelines are private to Ago.Chat.Webhooks
         because only that host dispatches, a channel adapter's outbound call can be made from whichever
         host runs that adapter (a webhook receiver, a long-polling worker - `14-02`/`14-03` decide).
         ChannelResiliencePipelines/ResilientInboundChannelAdapter therefore live here, host-agnostic,
         the same place ChannelMessagePipeline sits for the same reason. -->
    <PackageReference Include="Ago.Platform.Resilience" />
  </ItemGroup>

  <ItemGroup Condition="'$(AgoPlatformDevOverride)' == 'true'">
    <ProjectReference Include="..\..\..\ago-platform\src\Ago.Platform.Hosting\Ago.Platform.Hosting.csproj" />
    <ProjectReference Include="..\..\..\ago-platform\src\Ago.Platform.Messaging.RabbitMq\Ago.Platform.Messaging.RabbitMq.csproj" />
    <ProjectReference Include="..\..\..\ago-platform\src\Ago.Platform.Realtime\Ago.Platform.Realtime.csproj" />
    <ProjectReference Include="..\..\..\ago-platform\src\Ago.Platform.Caching.Redis\Ago.Platform.Caching.Redis.csproj" />
    <ProjectReference Include="..\..\..\ago-platform\src\Ago.Platform.Storage.S3\Ago.Platform.Storage.S3.csproj" />
    <ProjectReference Include="..\..\..\ago-platform\src\Ago.Platform.Resilience\Ago.Platform.Resilience.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ago.Chat.Application\Ago.Chat.Application.csproj" />
    <ProjectReference Include="..\Ago.Chat.Infrastructure.Postgres\Ago.Chat.Infrastructure.Postgres.csproj" />
    <!-- `14-02`: MaxChannelAdapter/MaxApiClient are registered here, alongside every other host-agnostic
         port - the same reasoning ChannelResiliencePipelines above already states for why this project,
         not Ago.Chat.Api or Ago.Chat.Worker individually. -->
    <ProjectReference Include="..\Ago.Chat.Infrastructure.MaxBot\Ago.Chat.Infrastructure.MaxBot.csproj" />
    <!-- `14-07`: TelegramChannelAdapter/TelegramApiClient are registered here, the same reasoning as
         the MAX reference above. -->
    <ProjectReference Include="..\Ago.Chat.Infrastructure.Telegram\Ago.Chat.Infrastructure.Telegram.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ago.Chat.Module\Ago.Chat.Module.csproj" />
    <!-- `8-07`: this host mints (Api) or expires (Worker) demo tenants, so it talks to Keycloak.
         Ago.Chat.Webhooks deliberately does not reference this and is never handed the credential. -->
    <ProjectReference Include="..\Ago.Chat.Infrastructure.Keycloak\Ago.Chat.Infrastructure.Keycloak.csproj" />
    <ProjectReference Include="..\Ago.Chat.Contracts\Ago.Chat.Contracts.csproj" />
    <!-- `14-02`: MaxWebhookEndpoints reads MaxUpdate/MaxInboundMessageParser directly (the webhook
         receiver's own translation from MAX's wire shape to ReceiveChannelMessage) and
         MaxChannelEndpoints calls MaxApiClient.SubscribeWebhookAsync - both genuinely used here, not
         only transitively through Ago.Chat.Module, the same "explicit when actually used" reasoning
         Ago.Chat.Infrastructure.Keycloak's own reference above already follows. -->
    <ProjectReference Include="..\Ago.Chat.Infrastructure.MaxBot\Ago.Chat.Infrastructure.MaxBot.csproj" />
    <!-- `14-07`: TelegramChannelEndpoints calls TelegramApiClient.GetMeAsync directly (this channel's
         own "reject a bad token immediately" step) - the same "explicit when actually used" reasoning
         the MAX reference above already follows. Unlike MAX there is no webhook receiver here, so this
         is the only reason Ago.Chat.Api references this project at all. -->
    <ProjectReference Include="..\Ago.Chat.Infrastructure.Telegram\Ago.Chat.Infrastructure.Telegram.csproj" />
  </ItemGroup>


  <!-- `7-09`: telemetry moved out of Ago.Platform.Hosting into its own package, so the hosts that
       actually wire it declare it themselves. Ago.Chat.Module deliberately does not - it is
       host-agnostic, and a package that needs an IEndpointRouteBuilder does not belong there. -->
  <ItemGroup Condition="'$(AgoPlatformDevOverride)' != 'true'">
    <PackageReference Include="Ago.Platform.Observability" />
  </ItemGroup>

  <ItemGroup Condition="'$(AgoPlatformDevOverride)' == 'true'">
    <ProjectReference Include="..\..\..\ago-platform\src\Ago.Platform.Observability\Ago.Platform.Observability.csproj" />
  </ItemGroup>

</Project>

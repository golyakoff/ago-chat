<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Mono.Cecil" />
    <PackageReference Include="NetArchTest.Rules" />
    <!-- `20-07`: guard 2 - the source-level scan for a string literal of a known module key. A
         different technique from guard 1's IL scan (MessageOpacityRule/Mono.Cecil) on purpose - see
         ModuleKeyLiteralRule's own remarks for why. Source-only (no compilation/semantic analysis
         needed - a plain string literal token is enough), so only the Roslyn C# syntax package is
         referenced, not Microsoft.CodeAnalysis.CSharp.Workspaces or a full compilation. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Referencing every product assembly here, once, is what lets each test load an assembly by
      simple name (TestAssemblies.cs) instead of by a fragile hard-coded output path - MSBuild
      guarantees these .dlls sit next to this test project's own output.
    -->
    <ProjectReference Include="..\..\src\Ago.Chat.Domain\Ago.Chat.Domain.csproj" />
    <ProjectReference Include="..\..\src\Ago.Chat.Application\Ago.Chat.Application.csproj" />
    <ProjectReference Include="..\..\src\Ago.Chat.Contracts\Ago.Chat.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Ago.Chat.Infrastructure.Postgres\Ago.Chat.Infrastructure.Postgres.csproj" />
    <!-- `20-07`: MessageOpacityTests' own EveryChatAssembly needs to reach this project's compiled
         output too - it is the one project that translates untrusted wire bytes into this system's own
         value objects, which makes it the most likely place a module's domain vocabulary would leak in
         by accident. -->
    <ProjectReference Include="..\..\src\Ago.Chat.Infrastructure.Modules\Ago.Chat.Infrastructure.Modules.csproj" />
    <ProjectReference Include="..\..\src\Ago.Chat.Module\Ago.Chat.Module.csproj" />
    <!--
      `8-08`: the four deployables. Until this item, no arch rule had anything to say about a host, so
      none was referenced here - the layering rules all concern the projects underneath. The rule this
      item adds is specifically about hosts ("only Ago.Chat.Migrator may apply a migration"), so their
      assemblies have to be loadable. Ago.Chat.Integration.Tests already references all four the same
      way, so this is an established shape rather than a new one.
    -->
    <ProjectReference Include="..\..\src\Ago.Chat.Api\Ago.Chat.Api.csproj" />
    <ProjectReference Include="..\..\src\Ago.Chat.Worker\Ago.Chat.Worker.csproj" />
    <ProjectReference Include="..\..\src\Ago.Chat.Webhooks\Ago.Chat.Webhooks.csproj" />
    <ProjectReference Include="..\..\src\Ago.Chat.Migrator\Ago.Chat.Migrator.csproj" />
    <!-- `22-16`: the fifth deployable, and the second one-shot tool (Ago.Chat.Migrator is the first) -
         RoleAssignmentProjectionBackfillHostTests needs its compiled output loadable the same way. -->
    <ProjectReference Include="..\..\src\Ago.Chat.RoleAssignmentBackfill\Ago.Chat.RoleAssignmentBackfill.csproj" />
  </ItemGroup>

</Project>

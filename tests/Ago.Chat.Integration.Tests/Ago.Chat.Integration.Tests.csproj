<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(AgoPlatformDevOverride)' != 'true'">
    <PackageReference Include="Ago.Platform.Kernel" />
    <PackageReference Include="Ago.Platform.Messaging.RabbitMq" />
    <PackageReference Include="Ago.Platform.Realtime" />
    <PackageReference Include="Ago.Platform.Caching.Redis" />
    <PackageReference Include="Ago.Platform.Storage.S3" />
  </ItemGroup>

  <ItemGroup Condition="'$(AgoPlatformDevOverride)' == 'true'">
    <ProjectReference Include="..\..\..\ago-platform\src\Ago.Platform.Kernel\Ago.Platform.Kernel.csproj" />
    <ProjectReference Include="..\..\..\ago-platform\src\Ago.Platform.Messaging.RabbitMq\Ago.Platform.Messaging.RabbitMq.csproj" />
    <ProjectReference Include="..\..\..\ago-platform\src\Ago.Platform.Realtime\Ago.Platform.Realtime.csproj" />
    <ProjectReference Include="..\..\..\ago-platform\src\Ago.Platform.Caching.Redis\Ago.Platform.Caching.Redis.csproj" />
    <ProjectReference Include="..\..\..\ago-platform\src\Ago.Platform.Storage.S3\Ago.Platform.Storage.S3.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.RabbitMq" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="Testcontainers.Minio" />
    <PackageReference Include="Testcontainers.Keycloak" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!-- `13-07`: a real SignalR client, the same package `Ago.Chat.LoadDriver` already uses (its own
         csproj remarks) - ActiveSiteHubResolutionTests needs a genuine hub connection, over a real
         WebSocket, to verify the active-site query-string mechanism actually reaches the hub
         handshake in this app's own transport configuration, not a guess. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <!-- `7-01`: TracingEndToEndTests' own in-memory span exporter - this item's Done-when proves
         correctness against one, not a live Jaeger (that is 7-03's job). -->
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="keycloak-realm-import.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- `20-07`: ModuleTaskGatewayIntegrationTests' own in-process fake module server - a minimal
       Kestrel host, not a separate real process the way FakeMax/FakeCrm are (this project is a plain
       Microsoft.NET.Sdk class library, not Sdk.Web, and a FrameworkReference is enough to get
       WebApplication/Kestrel without switching the whole project's SDK). Deliberately lighter than the
       FakeMax/FakeCrm technique: the claim under test (reply-by-id parity, unreachable-module
       degrade) needs a real HTTP boundary, not a real separate OS process this test can kill. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ago.Chat.Infrastructure.Postgres\Ago.Chat.Infrastructure.Postgres.csproj" />
    <ProjectReference Include="..\..\src\Ago.Chat.Infrastructure.Modules\Ago.Chat.Infrastructure.Modules.csproj" />
    <ProjectReference Include="..\..\src\Ago.Chat.Worker\Ago.Chat.Worker.csproj" />
    <ProjectReference Include="..\..\src\Ago.Chat.Api\Ago.Chat.Api.csproj" />
    <!-- `6-05`: the dispatcher under test. -->
    <ProjectReference Include="..\..\src\Ago.Chat.Webhooks\Ago.Chat.Webhooks.csproj" />
    <!-- `8-08`: the migrator under test. Referenced for MigratorRunner's exit-code contract, and so
         that MSBuild copies Ago.Chat.Api's own runtimeconfig/deps next to this project's output -
         SchemaGuardRefusalTests launches that host as a real process, the same technique
         FakeCrmProcessFixture established. -->
    <ProjectReference Include="..\..\src\Ago.Chat.Migrator\Ago.Chat.Migrator.csproj" />
    <!-- `6-05`: reuses FakeCrmProcessFixture (real-process launch, dynamic ports) rather than
         duplicating that ~130-line technique here - a test-project-to-test-project reference, unusual
         but the same "make other tests real" project Ago.Chat.FakeCrm.csproj's own remarks describe;
         transitively pulls in Ago.Chat.FakeCrm itself. -->
    <ProjectReference Include="..\Ago.Chat.FakeCrm.Tests\Ago.Chat.FakeCrm.Tests.csproj" />
    <!-- `14-02`: MaxChannelAdapterResilienceTests' own real-process MAX stand-in - FakeCrm.Tests' own
         precedent, reused for the inbound-channel port's first real HTTP boundary. -->
    <ProjectReference Include="..\Ago.Chat.FakeMax.Tests\Ago.Chat.FakeMax.Tests.csproj" />
    <ProjectReference Include="..\..\src\Ago.Chat.Infrastructure.MaxBot\Ago.Chat.Infrastructure.MaxBot.csproj" />
    <!-- `14-07`: TelegramInboundMessageParserTests/TelegramApiClientTests/TelegramProxyTests' own
         real HTTP boundary - the same reasoning as the MAX reference above. -->
    <ProjectReference Include="..\..\src\Ago.Chat.Infrastructure.Telegram\Ago.Chat.Infrastructure.Telegram.csproj" />
    <!-- `14-08`: VkInboundMessageParserTests/VkWebhookEndpointsTests' own real HTTP boundary - the same
         reasoning as the MAX/Telegram references above. -->
    <ProjectReference Include="..\..\src\Ago.Chat.Infrastructure.Vk\Ago.Chat.Infrastructure.Vk.csproj" />
    <!-- `14-11`: AvitoInboundMessageParserTests/AvitoApiClientTests/AvitoChannelAdapterTests/
         AvitoWebhookEndpointsTests' own real HTTP boundary - the same reasoning as the MAX/Telegram/VK
         references above. -->
    <ProjectReference Include="..\..\src\Ago.Chat.Infrastructure.Avito\Ago.Chat.Infrastructure.Avito.csproj" />
    <!-- `14-10`: WhatsAppInboundMessageParserTests/WhatsAppWebhookEndpointsTests' own real HTTP boundary -
         the same reasoning as the MAX/Telegram/VK references above. -->
    <ProjectReference Include="..\..\src\Ago.Chat.Infrastructure.WhatsApp\Ago.Chat.Infrastructure.WhatsApp.csproj" />
    <!-- `13-02`: YooKassaPaymentsApiClientTests/YooKassaWebhookEndpointTests' own real HTTP boundary -
         the same reasoning as the MAX/Telegram references above. -->
    <ProjectReference Include="..\..\src\Ago.Chat.Infrastructure.YooKassa\Ago.Chat.Infrastructure.YooKassa.csproj" />
    <ProjectReference Include="..\..\src\Ago.Chat.Infrastructure.YandexGpt\Ago.Chat.Infrastructure.YandexGpt.csproj" />
    <ProjectReference Include="..\..\src\Ago.Chat.Module\Ago.Chat.Module.csproj" />
  </ItemGroup>


  <!-- `7-09`: telemetry moved out of Ago.Platform.Hosting into its own package, so the hosts that
       actually wire it declare it themselves. Ago.Chat.Module deliberately does not - it is
       host-agnostic, and a package that needs an IEndpointRouteBuilder does not belong there. -->
  <ItemGroup Condition="'$(AgoPlatformDevOverride)' != 'true'">
    <PackageReference Include="Ago.Platform.Observability" />
  </ItemGroup>

  <ItemGroup Condition="'$(AgoPlatformDevOverride)' == 'true'">
    <ProjectReference Include="..\..\..\ago-platform\src\Ago.Platform.Observability\Ago.Platform.Observability.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ProjectReference, not a package reference: FakeCrmProcessFixture launches this project's own
      built .dll as a genuinely separate `dotnet` process (via typeof(Program).Assembly.Location), and
      both test classes call WebhookSignatureVerifier.Sign directly to build requests the harness's
      own Verify should accept - the same technique TestAssemblies.cs (Architecture.Tests) uses to load
      a sibling project's assembly by simple name rather than a hard-coded output path.
    -->
    <ProjectReference Include="..\Ago.Chat.FakeCrm\Ago.Chat.FakeCrm.csproj" />
  </ItemGroup>

</Project>

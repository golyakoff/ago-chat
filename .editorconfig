root = true

[*]
indent_style = space
end_of_line = lf
insert_final_newline = true
charset = utf-8-bom
trim_trailing_whitespace = true

[*.{yml,yaml,json,md}]
charset = utf-8
indent_size = 2

[*.cs]
indent_size = 4
csharp_using_directive_placement = outside_namespace:error

# File-scoped namespaces only (docs/conventions/coding-style.md). Enforced by `dotnet format
# --verify-no-changes` in CI (backlog/0-04-ci-pipeline.md); nullable and other compiler warnings
# are already build errors via Directory.Build.props' TreatWarningsAsErrors.
csharp_style_namespace_declarations = file_scoped:error

csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion

# var when the type is obvious from the right-hand side, explicit otherwise.
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

[*.{csproj,props,targets,sln,slnx}]
indent_size = 2

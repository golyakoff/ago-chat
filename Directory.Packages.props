<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Without this, the central version pin below only binds a project's own direct
         PackageReferences - Api/Worker/Webhooks/Module never reference EF Core directly (they get
         it only transitively, through Infrastructure.Postgres's ProjectReference), so without this
         flag their restore graph could still pick Npgsql.EntityFrameworkCore.PostgreSQL's own
         transitive EFCore version instead of the pinned one, producing an MSB3277 assembly-version
         conflict at compile time (found by running a clean build - the warning survived the
         PackageVersion pin alone). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- 0.11.0: Ago.Platform.Abstractions.IEventConsumer.SubscribeAsync gained a required
         consumerName parameter - a breaking port change (`5-11`). Every Competing-mode subscriber in
         this repo now passes its own stable name; see each consumer's own updated call site for why
         (two independent consumer types sharing one RabbitMQ queue, silently splitting messages
         between them, found live while verifying `5-10`). ago-platform's CI packs every
         Ago.Platform.* project at one shared version read from ago-platform's own CHANGELOG.md at
         pack time (-p:Version=..., not Directory.Build.props's <Version> there, which packing
         ignores), so every package here bumps together even where a given package's own content did
         not change. -->
    <!-- `6-06`: bumped from 0.11.0 to 0.12.0 (every package here, not just Resilience) - ago-platform
         packs every Ago.Platform.* project at one shared version per pack regardless of whether a
         given package's own content changed (see Ago.Platform.Resilience's own history below), and
         `6-01`'s merge to ago-platform's main already moved that shared version to 0.12.0. Restoring
         this solution against a freshly packed local feed (workspace.md's own "pack ago-platform into
         it first if it is empty" step) failed with NU1109 ("package downgrade... 0.12.0 to 0.12.0")
         before this change - Hosting/Messaging.RabbitMq's own 0.12.0 packages depend on
         Kernel/Abstractions >= 0.12.0 transitively, which the old 0.11.0 pins here could never
         satisfy. Pre-existing staleness found while restoring for 6-06, not something that item's own
         work introduced - every host in this repository was unbuildable against a current local feed
         until this bump. -->
    <!-- `7-01`: bumped from 0.12.0 to 0.13.0, every package here again, matching every previous move
         on this page - `Ago.Platform.Abstractions.IOutboxWriter.Enqueue` gained an optional
         `traceContext` parameter, `Ago.Platform.Persistence.Postgres.OutboxMessage` gained a new
         `TraceContext` column, and `Ago.Platform.Hosting` gained `AddPlatformObservability` (see
         ago-platform's own CHANGELOG.md `[0.13.0]` entry). None of that is a breaking change (the new
         parameter is optional, defaulting to today's no-trace-context behaviour), but ago-platform
         still packs every project together at one shared version regardless. -->
    <!-- `7-02`: bumped from 0.13.0 to 0.14.0, every package here again, same reasoning as every
         previous move on this page - `Ago.Platform.Hosting.AddPlatformObservability` now also wires a
         `MeterProvider`, and `Ago.Platform.Resilience.ResiliencePolicyBuilder`'s constructor gained a
         required `pipelineName` parameter (a genuinely breaking change to this pre-1.0 package) -
         `Ago.Chat.Webhooks.WebhookResiliencePipelines` (`6-05`'s own `"Webhooks"`-named pipeline, the
         one real call site of this constructor in this repository) updated both of its call sites to
         pass its own existing `PipelineName` constant; no other change needed there for the
         breaker-state gauge and bulkhead-rejection counter this bump adds to cover webhook delivery
         automatically, exactly as `7-02`'s own Out-of-scope section anticipated.
         `Ago.Platform.Caching.Redis`/`Ago.Platform.Realtime`/`Ago.Platform.Messaging.RabbitMq` each
         gained a new manual `Meter` too (see ago-platform's own CHANGELOG.md `[0.14.0]` entry for the
         full list). -->
    <!-- `7-07`: bumped from 0.14.0 to 0.15.0, every package here again, for one fix in one of them.
         `Ago.Platform.Realtime`'s connections gauge counted calls to `IConnectionRegistry.RegisterAsync`
         rather than connections - and that method is also the heartbeat's TTL refresh, so the number
         climbed forever on a node with nobody connected. The gauge now reads
         `LocalConnectionTracker.Count` at collection time, with `AddConnectionRegistry` naming the
         tracker for its node through the new `RealtimeMetrics.TrackNode`.
         Additive public API only (`TrackNode`, `LocalConnectionTracker.Count`); the three `internal`
         increment/decrement methods that carried the bug are gone, which no consumer could call.
         **No change was needed in this repository** - `Ago.Chat.Api`/`Worker` reach the fix purely by
         restoring the new package, because the wiring lives in `AddConnectionRegistry`, which they
         already call. This bump is the entire delivery mechanism: without it the fix sits in
         ago-platform's `main` and never reaches anything that runs. -->
    <!-- `17-10`: bumped from 0.18.0 to 0.19.0. The fix itself is `17-09` - `RabbitMqConnection` and
         `RabbitMqEventPublisher` no longer let a `TaskCanceledException` out of `DisposeAsync`, and
         no longer leak their lock when they do, so a host stopping while the broker is gone finishes
         stopping. Both types gained a required `ILogger<T>` constructor parameter, which is
         source-breaking only for a direct `new` - this repository resolves both through
         `AddRabbitMqMessaging`, so nothing here changed.
         **Polly.Core and AWSSDK.S3 move with it, and that is the part worth reading.** `0.19.0`
         declares `Polly.Core >= 8.7.0` and `AWSSDK.S3 >= 4.0.102.4` because Dependabot raised them in
         ago-platform and this file never followed; central package management turns that into
         NU1109 "detected package downgrade" rather than resolving quietly, so a platform bump and its
         transitive floors are one change or neither.
         **And this bump is not optional maintenance.** `redeploy.sh` packs only the *current*
         platform version into the node's local feed, and the Docker build resolves `Ago.Platform.*`
         from that feed alone (`nuget.docker.config` clears every other source). While this file said
         0.18.0 and the feed held 0.19.0, `ago-chat` could not be built on the node at all - the
         redeploy aborted at image build with NU1603, before applying anything. A platform release
         strands a consumer's *deploy*, not just its fix. -->
    <PackageVersion Include="Ago.Platform.Hosting" Version="0.20.0" />
    <PackageVersion Include="Ago.Platform.Observability" Version="0.20.0" />
    <PackageVersion Include="Ago.Platform.Kernel" Version="0.20.0" />
    <PackageVersion Include="Ago.Platform.Abstractions" Version="0.20.0" />
    <PackageVersion Include="Ago.Platform.Persistence.Postgres" Version="0.20.0" />
    <PackageVersion Include="Ago.Platform.Messaging.RabbitMq" Version="0.20.0" />
    <PackageVersion Include="Ago.Platform.Realtime" Version="0.20.0" />
    <PackageVersion Include="Ago.Platform.Caching.Redis" Version="0.20.0" />
    <PackageVersion Include="Ago.Platform.Storage.S3" Version="0.20.0" />
    <PackageVersion Include="Ago.Platform.Resilience" Version="0.20.0" />
  </ItemGroup>

  <ItemGroup Label="Attachments">
    <!-- `5-04`: AttachmentThumbnailGenerator (Ago.Chat.Worker) only - MIT license, unconditionally
         free for commercial use (see Ago.Chat.Worker.csproj's own remarks on why this was chosen
         over SixLabors.ImageSharp's revenue-gated split license). -->
    <PackageVersion Include="SkiaSharp" Version="4.151.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" />
  </ItemGroup>

  <ItemGroup Label="Realtime and auth">
    <!-- 1-06: JWT is the token shape for both the visitor capability and the operator dev-auth
         stub (authorization.md - OIDC access tokens are JWTs too, so this is the shape Stage 5
         inherits, not a throwaway one). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <!-- `5-05`: TestServer for the OIDC integration test - a real in-memory ASP.NET Core auth
         pipeline, not JWT-validation-in-isolation. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    <!-- `6-06`: Ago.Chat.LoadDriver's own real SignalR client - the same package a real widget/console
         host would ship, matching this repo's .NET 10 / ASP.NET Core 10.0.11 pin above rather than an
         older LTS line. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <!-- adr/0004: EF Core owns writes, Dapper owns reads. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Pinned explicitly: Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 pulls EFCore 10.0.4
         transitively, which conflicts with Microsoft.EntityFrameworkCore.Design 10.0.11 below -
         both need the same version to resolve. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Dapper" Version="2.1.79" />
    <!-- 3-06: PostgresHealthCheck (Ago.Chat.Infrastructure.Postgres). -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.11" />
    <!-- `5-08`: DeleteAttachmentHandler's own "log and continue" fallback for a storage-side delete
         failure - the same category of dependency-free framework *abstraction* (interfaces only, no
         concrete sink) Application already treats Ago.Platform.Kernel/Abstractions as being in-bounds
         for, not a concrete logging provider. Api/Worker never needed this pin directly - they get
         the interface transitively through the ASP.NET Core/Generic Host shared framework, which
         Ago.Chat.Application (a plain class library, no Sdk.Web) does not reference. -->
    <!-- `8-07`: Ago.Chat.Infrastructure.Keycloak is the first project here to make outbound HTTP
         calls of its own with a typed client. Options is the binding it validates its credential
         with; Http is IHttpClientFactory, which is what makes the client a seam a host can wrap
         with resilience rather than a `new HttpClient()` nothing can reach. -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <!-- `14-02`: Ago.Chat.Infrastructure.MaxBot's own MaxLongPollingService (BackgroundService) and
         its IServiceScopeFactory-per-poll shape (MaxChannelAdapter's own remarks on why a singleton
         adapter must open its own scope) - a plain class library (Microsoft.NET.Sdk, not Sdk.Web)
         needs both explicitly, the same reason Microsoft.Extensions.Http is pinned here rather than
         inherited from the ASP.NET Core shared framework. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!-- Ago.Platform.Caching.Redis's own resilience pipeline type (ResiliencePipeline), needed
         directly by tests that construct a RedisCache by hand against a Testcontainers Redis. -->
    <PackageVersion Include="Polly.Core" Version="8.7.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- `20-07`: guard 2's own source-level scan (ModuleKeyLiteralRule) - a plain syntax-tree walk over
         each .cs file's own text, no semantic model / no Workspaces package needed. Pinned to 5.0.0.,
         not the newest-at-write-time; matches what Microsoft.EntityFrameworkCore.Design 10.0.11 already
         requires transitively (found by running the build - a lower pin here produced an NU1109
         downgrade/NU1608 error against that transitive floor). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.14.0" />
    <!-- `5-03`: MinioFixture-equivalent for Ago.Chat.Integration.Tests' attachment flow tests -
         ago-platform's own Ago.Platform.Integration.Tests pins the same image tag (5-02). -->
    <PackageVersion Include="Testcontainers.Minio" Version="4.14.0" />
    <!-- `5-05`: a real Keycloak for the OIDC token-resolution integration test - matches every other
         Testcontainers package's pinned version in this project. -->
    <PackageVersion Include="Testcontainers.Keycloak" Version="4.14.0" />
    <!-- AttachmentFixture builds the bucket directly via the S3 API, same version ago-platform pins. -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.102.4" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup Label="Observability">
    <!-- `7-01`: matches ago-platform's own Directory.Packages.props pin exactly - only
         Ago.Chat.Integration.Tests references these, to build a raw in-memory-exported
         TracerProvider for TracingEndToEndTests; production code never references the OTel SDK
         directly, only Ago.Platform.Hosting.AddPlatformObservability. -->
    <PackageVersion Include="OpenTelemetry" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.18.0" />
    <!-- The one exception to the "production code never references the OTel SDK directly" note
         above, added 2026-09-02 with TelegramTraceUrlRedaction: Telegram puts its bot token in the
         URL path, the HttpClient instrumentation records that path as `url.full`, and the only hook
         that can redact it is HttpClientTraceInstrumentationOptions - which lives in this package and
         has no abstraction in front of it worth inventing. Ago.Chat.Infrastructure.Telegram is the
         one production project that references it, matching that project's own "everything that
         knows Telegram's HTTP shape lives here and nowhere above it" rule. Same pin as the rest. -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <!-- TelegramTraceUrlRedactionTests' own end-to-end fact builds its TracerProvider through a real
         IServiceCollection rather than Sdk.CreateTracerProviderBuilder(), because the thing under test
         *is* the IOptions wiring - Sdk.CreateTracerProviderBuilder() would never see it. That is what
         needs this package's AddOpenTelemetry() overload. Same pin as the rest. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
  </ItemGroup>

</Project>
